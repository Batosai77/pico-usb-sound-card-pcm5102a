# Build directories & artifacts (repo root only)
cmake-build-*/
/*.elf
/*.bin
/*.hex
/*.dis
/*.map

# CMake cache inside build/ (firmware outputs in build/ are tracked)
build/_deps/
build/CMakeFiles/
build/CMakeCache.txt
build/cmake_install.cmake
build/Makefile
build/pico-sdk/
build/picotool/
build/generated/
build/pioasm/
build/pioasm-install/
build/pico_dac_pcm5102.*

# Pico SDK clone (automatically cloned by build.sh if missing)
pico-sdk/

# Python cache & temporary files
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# Editor & OS files
.vscode/
.idea/
*.swp
*~
.DS_Store
